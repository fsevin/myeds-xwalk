{
  "info": {
    "name": "Firefly Video Generation (SANDBOX org)",
    "description": "Tests Adobe Firefly's Video API (video1_standard) using an uploaded product image as the starting keyframe — the video analog of the product-variant image flow.\n\nEndpoint: POST /v3/videos/generate, header x-model-version: video1_standard. Async: returns 202 with a jobId/statusUrl/cancelUrl, same job-polling pattern as the Image5 collection. Generates 5-second clips.\n\nNote: the job result reuses the generic `image` field name even for video output — `result.outputs[0].image.url` actually points to the generated .mp4 file.\n\nRun order:\n  1. Get IMS Access Token\n  2. Upload Reference Product Image (v2 storage) — attach a product photo in the Body tab\n  3. Generate Video from Image (async) — image anchors frame position 0 (first frame)\n  4. Check Job Status — keep clicking Send until status is 'succeeded'\n  5. Download Generated Video — optional, fetches {{video_url}}\n  (Optional) Cancel Job — PUT {{cancel_url}} if you need to abort a running job\n\nUses {{client_id}}/{{client_secret}}/{{scopes}}/{{prompt}} from the Firefly-Sandbox environment — no secrets are stored in this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Get IMS Access Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Token received', function () { pm.expect(data.access_token).to.be.a('string'); });",
              "if (data.access_token) { pm.collectionVariables.set('access_token', data.access_token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials"
            },
            {
              "key": "client_id",
              "value": "{{client_id}}"
            },
            {
              "key": "client_secret",
              "value": "{{client_secret}}"
            },
            {
              "key": "scope",
              "value": "{{scopes}}"
            }
          ]
        },
        "url": {
          "raw": "https://ims-na1.adobelogin.com/ims/token/v3",
          "protocol": "https",
          "host": [
            "ims-na1",
            "adobelogin",
            "com"
          ],
          "path": [
            "ims",
            "token",
            "v3"
          ]
        }
      }
    },
    {
      "name": "2. Upload Reference Product Image (v2 storage)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "const id = data.images && data.images[0] && data.images[0].id;",
              "pm.test('Upload id returned', function () { pm.expect(id).to.be.a('string'); });",
              "if (id) {",
              "  pm.collectionVariables.set('upload_id', id);",
              "  console.log('Uploaded reference image, id:', id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "image/jpeg"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "x-api-key",
            "value": "{{client_id}}"
          }
        ],
        "body": {
          "mode": "file",
          "file": {}
        },
        "url": {
          "raw": "https://firefly-api.adobe.io/v2/storage/image",
          "protocol": "https",
          "host": [
            "firefly-api",
            "adobe",
            "io"
          ],
          "path": [
            "v2",
            "storage",
            "image"
          ]
        },
        "description": "Before sending: in the Body tab, click 'Select File' and choose a product photo (jpeg/png/webp/tiff/jxl, max 15MB)."
      }
    },
    {
      "name": "3. Generate Video from Image (async, x-model-version: video1_standard)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Job accepted (202)', function () { pm.response.to.have.status(202); });",
              "const data = pm.response.json();",
              "pm.test('jobId and statusUrl returned', function () {",
              "  pm.expect(data.jobId).to.be.a('string');",
              "  pm.expect(data.statusUrl).to.be.a('string');",
              "});",
              "if (data.jobId) {",
              "  pm.collectionVariables.set('job_id', data.jobId);",
              "  pm.collectionVariables.set('status_url', data.statusUrl);",
              "  pm.collectionVariables.set('cancel_url', data.cancelUrl);",
              "  console.log('Video job submitted:', data.jobId, '-> poll:', data.statusUrl);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "x-api-key",
            "value": "{{client_id}}"
          },
          {
            "key": "x-model-version",
            "value": "video1_standard"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"{{prompt}}\",\n  \"image\": {\n    \"conditions\": [\n      {\n        \"source\": {\n          \"uploadId\": \"{{upload_id}}\"\n        },\n        \"placement\": {\n          \"position\": 0\n        }\n      }\n    ]\n  },\n  \"sizes\": [\n    {\n      \"width\": 1920,\n      \"height\": 1080\n    }\n  ],\n  \"videoSettings\": {\n    \"cameraMotion\": \"camera zoom in\",\n    \"shotSize\": \"medium shot\",\n    \"shotAngle\": \"eye_level shot\",\n    \"promptStyle\": \"cinematic\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://firefly-api.adobe.io/v3/videos/generate",
          "protocol": "https",
          "host": [
            "firefly-api",
            "adobe",
            "io"
          ],
          "path": [
            "v3",
            "videos",
            "generate"
          ]
        },
        "description": "Run after request 2. Uses the uploaded product photo as the video's first frame (placement.position: 0) — set position: 1 to use it as the last frame instead. Adjust videoSettings (cameraMotion/shotSize/shotAngle/promptStyle) or sizes to taste; see Adobe's usage-notes page for supported aspect ratios/dimensions."
      }
    },
    {
      "name": "4. Check Job Status (poll — click Send until status=succeeded)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const data = pm.response.json();",
              "pm.test('Status call succeeded', function () { pm.response.to.have.status(200); });",
              "console.log('Job status:', data.status);",
              "if (data.status === 'succeeded') {",
              "  const url = data.result && data.result.outputs && data.result.outputs[0] && data.result.outputs[0].image && data.result.outputs[0].image.url;",
              "  pm.test('Video url present on success', function () { pm.expect(url).to.be.a('string'); });",
              "  if (url) {",
              "    pm.collectionVariables.set('video_url', url);",
              "    console.log('Generated video URL (mp4):', url);",
              "  }",
              "} else if (['failed', 'cancelled', 'timeout'].includes(data.status)) {",
              "  pm.expect.fail('Job ended with status: ' + data.status + ' — ' + JSON.stringify(data));",
              "} else {",
              "  console.log('Still ' + data.status + ' — video jobs can take a minute or two, click Send again shortly.');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "x-api-key",
            "value": "{{client_id}}"
          }
        ],
        "url": {
          "raw": "{{status_url}}",
          "host": [
            "{{status_url}}"
          ]
        },
        "description": "Run after request 3. Video generation is async and typically slower than image jobs — re-send every ~10-15s until status is 'succeeded'."
      }
    },
    {
      "name": "5. Download Generated Video",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{video_url}}",
          "host": [
            "{{video_url}}"
          ]
        },
        "description": "Downloads the generated .mp4. Presigned Firefly URLs are time-limited (~1 hour)."
      }
    },
    {
      "name": "(Optional) Cancel Job",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "x-api-key",
            "value": "{{client_id}}"
          }
        ],
        "url": {
          "raw": "{{cancel_url}}",
          "host": [
            "{{cancel_url}}"
          ]
        },
        "description": "Cancels the in-flight job from request 3, if you need to abort a long-running generation."
      }
    }
  ],
  "variable": [
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "upload_id",
      "value": ""
    },
    {
      "key": "job_id",
      "value": ""
    },
    {
      "key": "status_url",
      "value": ""
    },
    {
      "key": "cancel_url",
      "value": ""
    },
    {
      "key": "video_url",
      "value": ""
    }
  ]
}
